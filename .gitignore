# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored so nested packages (homiehouselol-bot/) are covered too.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Local databases — homiehouselol-bot/memory.db was committed with real user
# conversations and profiles in it.
*.db
*.sqlite
*.sqlite3
