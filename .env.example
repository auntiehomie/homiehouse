# ── Stripe Billing (HomieHouse Pro) ──────────────────────────────────────────
# Required for subscription checkout, customer portal, and webhook handling.
# Create these in the Stripe Dashboard (https://dashboard.stripe.com):
#
#   STRIPE_SECRET_KEY          - Dashboard → Developers → API keys → Secret key (`sk_live_...`) or restricted Billing key (`rk_live_...`)
#   STRIPE_WEBHOOK_SECRET      - Dashboard → Developers → Webhooks → Add endpoint →
#                                URL: https://homiehouse.app/api/stripe/webhook
#                                Events: checkout.session.completed, customer.subscription.updated,
#                                        customer.subscription.deleted, invoice.payment_succeeded,
#                                        invoice.payment_failed
#   STRIPE_PRO_MONTHLY_PRICE_ID - Dashboard → Products → HomieHouse Pro → Pricing → Price ID (price_...)
#   NEXT_PUBLIC_BASE_URL        - Production URL for success/cancel redirects (used as fallback)
#
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
# Create a recurring $1/month product in Stripe for Ask Homie Pro.
STRIPE_ASK_HOMIE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_BASE_URL=https://homiehouse.app

# Optional current web research for Ask Homie and @thehomie replies.
# Create a key at https://brave.com/search/api/ and keep it server-side only.
BRAVE_API_KEY=

# Optional, user-requested Ask Homie search of recent public X posts.
# Create an app-only Bearer Token in the X Developer Console. This remains
# disabled until both variables are set. Each enabled turn is Pro-only, uses
# recent search (last 7 days), and reserves up to five paid post reads.
# Configure a hard spend limit in X Developer Console before enabling it.
X_RESEARCH_ENABLED=false
X_RESEARCH_BEARER_TOKEN=

# Optional explicit domain for verifying Hypersnap protocol-auth tokens.
# Use the exact host users sign for (no scheme or path); set this to the
# Vercel preview host when testing protocol login on a preview deployment.
HOMIEHOUSE_AUTH_DOMAIN=homiehouse.app

# ── Session authentication ───────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 48
# Keep stable across deployments/instances; rotate to invalidate all sessions.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Required to encrypt signer keys saved for scheduled casts. Generate once and
# keep stable across deployments. Before enabling this on an existing database,
# run the scheduled signer-key migration described in docs/SECURITY_REVIEW.md.
SIGNER_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# HH2 staking is disabled until the non-upgradeable escrow contract has been
# reviewed, deployed to Base, and verified on BaseScan.
NEXT_PUBLIC_HH2_STAKING_CONTRACT_ADDRESS=
# Optional Base RPC used by the server to verify stake, withdrawal, and burn transactions.
BASE_RPC_URL=https://mainnet.base.org

# X AI-generated mention replies require written approval and an explicit opt-in.
# Keep false/blank until that approval has been recorded.
X_AGENT_ENABLED=false
X_AI_REPLY_APPROVAL_CONFIRMED=

# Optional server-only URL for your personal Hypersnap node's
# /v1/submitMessage API. Set a URL reachable by the HomieHouse server. If
# unavailable, submissions fall back to Haatz.
MY_HYPERSNAP_NODE_URL=
# Older aliases remain supported for existing deployments.
HYPERSNAP_NODE_URL=
HYPERSNAP_FALLBACK_URL=https://haatz.quilibrium.com
# SNAPCHAIN_NODE_URL=
# SNAPCHAIN_FALLBACK_URL=

# Optional Community discovery window and publishing-client filters.
# The FIDs below identify client apps that registered cast signing keys, not authors.
# Filtering requires a Hypersnap node with the trending_exclude_signer_fids change.
# Community defaults to the broadest currently supported Hypersnap window (7d).
# Override with 1h, 6h, 12h, 24h, or 7d.
# HOMIEHOUSE_COMMUNITY_TRENDING_WINDOW=7d
# HOMIEHOUSE_COMMUNITY_INCLUDE_SIGNER_FIDS=
# HOMIEHOUSE_COMMUNITY_EXCLUDE_SIGNER_FIDS=
